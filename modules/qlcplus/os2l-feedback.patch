+/*************************************************************************
+ * Feedback
+ *************************************************************************/
+
+bool OS2LPlugin::openOutput(quint32 output, quint32 universe)
+{
+    if (output != 0)
+        return false;
+
+    addToMap(universe, output, Feedback);
+
+    return true;
+}
+
+void OS2LPlugin::closeOutput(quint32 output, quint32 universe)
+{
+    removeFromMap(output, universe, Feedback);
+}
+
+QStringList OS2LPlugin::outputs()
+{
+    /** Same name as the input line, so that QLC+ can pair the
+     *  two when enabling feedback on a universe */
+    return inputs();
+}
+
+QString OS2LPlugin::outputInfo(quint32 output)
+{
+    return inputInfo(output);
+}
+
+void OS2LPlugin::sendFeedBack(quint32 universe, quint32 output, quint32 channel,
+                              uchar value, const QVariant &params)
+{
+    Q_UNUSED(universe)
+    Q_UNUSED(output)
+
+    /** The input profile provides the button name. Without a profile,
+     *  fall back to the names seen in the messages received so far */
+    QString name;
+    if (params.userType() == QMetaType::QString)
+        name = params.toString();
+    if (name.isEmpty())
+        name = m_hashMap.key(quint16(channel & 0xFFFF));
+    if (name.isEmpty())
+        return;
+
+    QJsonObject jsonObj;
+    jsonObj.insert("evt", "feedback");
+    jsonObj.insert("name", name);
+    if (m_pageMap.contains(name))
+        jsonObj.insert("page", m_pageMap.value(name));
+    jsonObj.insert("state", value ? "on" : "off");
+
+    m_feedbackState[name] = value > 0;
+
+    QByteArray message = QJsonDocument(jsonObj).toJson(QJsonDocument::Compact);
+    qDebug() << "[OS2L] Sending feedback" << message;
+
+    for (QTcpSocket *client : std::as_const(m_clients))
+        client->write(message);
+}
