+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <stdlib.h>
+
+#include "waylanddrv.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(waylanddrv);
+
+/* Touch points are sent on as WM_POINTER* hardware messages, the same as
+ * winex11 does for XInput 2 touch events. The server turns the first
+ * touch point into mouse messages as well, for applications that only
+ * know about the mouse.
+ *
+ * All the handlers run in the thread that reads the Wayland events, so
+ * the touch point table needs no lock. */
+
+static struct wayland_touch_point *find_touch_point(int32_t id, BOOL create)
+{
+    struct wayland_touch *touch = &process_wayland.touch;
+    struct wayland_touch_point *unused = NULL;
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(touch->points); i++)
+    {
+        if (touch->points[i].hwnd && touch->points[i].id == id) return &touch->points[i];
+        if (!touch->points[i].hwnd && !unused) unused = &touch->points[i];
+    }
+
+    return create ? unused : NULL;
+}
+
+/* Maps a position on the surface of a window to the position the server
+ * expects in a touch message: a fraction of the virtual screen. */
+static BOOL get_touch_pos(HWND hwnd, wl_fixed_t sx, wl_fixed_t sy, POINT *pos)
+{
+    RECT virtual = NtUserGetVirtualScreenRect(MDT_RAW_DPI);
+    int width = virtual.right - virtual.left, height = virtual.bottom - virtual.top;
+    POINT screen = { wl_fixed_to_double(sx), wl_fixed_to_double(sy) };
+    struct wayland_surface *surface;
+    struct wayland_win_data *data;
+    RECT rect;
+
+    if (width <= 0 || height <= 0) return FALSE;
+    if (!(data = wayland_win_data_get(hwnd))) return FALSE;
+    if (!(surface = data->wayland_surface))
+    {
+        wayland_win_data_release(data);
+        return FALSE;
+    }
+
+    rect = surface->window.rect;
+    if (surface->role == WAYLAND_SURFACE_ROLE_SUBSURFACE && surface->placed)
+        OffsetRect(&rect, surface->placed_origin.x - rect.left, surface->placed_origin.y - rect.top);
+
+    screen = map_point_from_surface(surface, screen);
+    screen.x += rect.left;
+    screen.y += rect.top;
+
+    wayland_win_data_release(data);
+
+    if (screen.x < 0) screen.x = 0;
+    if (screen.y < 0) screen.y = 0;
+    /* The server divides again, rounding down; round up here so that it
+     * arrives at the same pixel. */
+    pos->x = min(((LONGLONG)screen.x * 65535 + width - 1) / width, 65535);
+    pos->y = min(((LONGLONG)screen.y * 65535 + height - 1) / height, 65535);
+    return TRUE;
+}
+
+static void send_touch_message(struct wayland_touch_point *point, UINT msg)
+{
+    INPUT input = {.type = INPUT_HARDWARE};
+    UINT flags = 0;
+
+    if (msg == WM_POINTERDOWN) flags |= POINTER_MESSAGE_FLAG_NEW;
+    if (msg != WM_POINTERUP) flags |= POINTER_MESSAGE_FLAG_INRANGE | POINTER_MESSAGE_FLAG_INCONTACT;
+
+    TRACE("hwnd=%p id=%d msg=%#x pos=%d,%d\n", point->hwnd, point->id, msg,
+          (int)point->pos.x, (int)point->pos.y);
+
+    input.hi.uMsg = msg;
+    input.hi.wParamL = point->id;
+    input.hi.wParamH = flags;
+    NtUserSendHardwareInput(point->hwnd, 0, &input, MAKELPARAM(point->pos.x, point->pos.y));
+}
+
+static void touch_handle_down(void *data, struct wl_touch *wl_touch, uint32_t serial,
+                              uint32_t time, struct wl_surface *wl_surface, int32_t id,
+                              wl_fixed_t sx, wl_fixed_t sy)
+{
+    struct wayland_touch_point *point;
+    HWND hwnd;
+
+    InterlockedExchange(&process_wayland.input_serial, serial);
+
+    if (!wl_surface) return;
+    /* The wl_surface user data remains valid and immutable for the whole
+     * lifetime of the object, so it's safe to access without locking. */
+    if (!(hwnd = wl_surface_get_user_data(wl_surface))) return;
+    if (!(point = find_touch_point(id, TRUE))) return;
+
+    point->id = id;
+    point->hwnd = hwnd;
+    if (!get_touch_pos(hwnd, sx, sy, &point->pos))
+    {
+        point->hwnd = 0;
+        return;
+    }
+
+    send_touch_message(point, WM_POINTERDOWN);
+}
+
+static void touch_handle_up(void *data, struct wl_touch *wl_touch, uint32_t serial,
+                            uint32_t time, int32_t id)
+{
+    struct wayland_touch_point *point;
+
+    InterlockedExchange(&process_wayland.input_serial, serial);
+
+    if (!(point = find_touch_point(id, FALSE))) return;
+    send_touch_message(point, WM_POINTERUP);
+    point->hwnd = 0;
+}
+
+static void touch_handle_motion(void *data, struct wl_touch *wl_touch, uint32_t time,
+                                int32_t id, wl_fixed_t sx, wl_fixed_t sy)
+{
+    struct wayland_touch_point *point;
+    POINT pos;
+
+    if (!(point = find_touch_point(id, FALSE))) return;
+    /* the window may be gone; the point then stays where it was */
+    if (!get_touch_pos(point->hwnd, sx, sy, &pos)) return;
+    point->pos = pos;
+    send_touch_message(point, WM_POINTERUPDATE);
+}
+
+static void touch_handle_frame(void *data, struct wl_touch *wl_touch)
+{
+}
+
+static void touch_handle_cancel(void *data, struct wl_touch *wl_touch)
+{
+    struct wayland_touch *touch = &process_wayland.touch;
+    unsigned int i;
+
+    /* The compositor has taken the touch points for itself, for a gesture
+     * of its own for example. */
+    for (i = 0; i < ARRAY_SIZE(touch->points); i++)
+    {
+        if (!touch->points[i].hwnd) continue;
+        send_touch_message(&touch->points[i], WM_POINTERUP);
+        touch->points[i].hwnd = 0;
+    }
+}
+
+static void touch_handle_shape(void *data, struct wl_touch *wl_touch, int32_t id,
+                               wl_fixed_t major, wl_fixed_t minor)
+{
+}
+
+static void touch_handle_orientation(void *data, struct wl_touch *wl_touch, int32_t id,
+                                     wl_fixed_t orientation)
+{
+}
+
+static const struct wl_touch_listener touch_listener =
+{
+    touch_handle_down,
+    touch_handle_up,
+    touch_handle_motion,
+    touch_handle_frame,
+    touch_handle_cancel,
+    touch_handle_shape,
+    touch_handle_orientation
+};
+
+void wayland_touch_init(struct wl_touch *wl_touch)
+{
+    struct wayland_touch *touch = &process_wayland.touch;
+
+    touch->wl_touch = wl_touch;
+    wl_touch_add_listener(wl_touch, &touch_listener, NULL);
+}
+
+void wayland_touch_deinit(void)
+{
+    struct wayland_touch *touch = &process_wayland.touch;
+
+    touch_handle_cancel(NULL, touch->wl_touch);
+    wl_touch_release(touch->wl_touch);
+    touch->wl_touch = NULL;
+}
