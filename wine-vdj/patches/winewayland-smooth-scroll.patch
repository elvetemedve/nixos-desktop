+/* Scroll distance, in wl_pointer.axis units, that makes one wheel notch.
+ * Xwayland uses the same scale, so a touchpad scrolls as far here as it
+ * does for X11 applications. */
+#define AXIS_DISTANCE_PER_NOTCH 10.0
+
+static pthread_mutex_t axis_mutex = PTHREAD_MUTEX_INITIALIZER;
+/* per axis: smooth scroll distance not yet sent, in notches */
+static double axis_distance[2];
+/* per axis: a wheel already reported a notch in the current frame */
+static BOOL axis_notch_in_frame[2];
+
+static void pointer_send_wheel(uint32_t axis, int32_t value120)
+{
+    INPUT input = {0};
+    HWND hwnd;
+
+    if (!(hwnd = wayland_pointer_get_focused_hwnd())) return;
+
+    input.type = INPUT_MOUSE;
+
+    switch (axis)
+    {
+    case WL_POINTER_AXIS_VERTICAL_SCROLL:
+        input.mi.dwFlags = MOUSEEVENTF_WHEEL;
+        input.mi.mouseData = -value120;
+        break;
+    case WL_POINTER_AXIS_HORIZONTAL_SCROLL:
+        input.mi.dwFlags = MOUSEEVENTF_HWHEEL;
+        input.mi.mouseData = value120;
+        break;
+    default: break;
+    }
+
+    TRACE("hwnd=%p axis=%u value120=%d\n", hwnd, axis, value120);
+
+    NtUserSendHardwareInput(hwnd, SEND_HWMSG_RAWINPUT, &input, 0);
+}
+
 static void pointer_handle_axis(void *data, struct wl_pointer *wl_pointer,
                                 uint32_t time, uint32_t axis, wl_fixed_t value)
 {
+    int notches = 0;
+
+    if (axis >= ARRAY_SIZE(axis_distance)) return;
+
+    /* A wheel reports each notch in axis_value120 or axis_discrete, which
+     * come ahead of this event in the same frame and have already sent it.
+     * What is left is distance with no notch attached -- touchpads and other
+     * continuous sources -- which Windows applications only see as wheel
+     * input. Send it in whole notches, as Xwayland does, and carry the
+     * remainder over to the next event. */
+    pthread_mutex_lock(&axis_mutex);
+    if (!axis_notch_in_frame[axis])
+    {
+        axis_distance[axis] += wl_fixed_to_double(value) / AXIS_DISTANCE_PER_NOTCH;
+        notches = trunc(axis_distance[axis]);
+        axis_distance[axis] -= notches;
+    }
+    pthread_mutex_unlock(&axis_mutex);
+
+    TRACE("axis=%u value=%f notches=%d\n", axis, wl_fixed_to_double(value), notches);
+
+    if (notches) pointer_send_wheel(axis, notches * WHEEL_DELTA);
 }
 
