 static void pointer_handle_axis_stop(void *data, struct wl_pointer *wl_pointer,
                                      uint32_t time, uint32_t axis)
 {
+    if (axis >= ARRAY_SIZE(axis_distance)) return;
+
+    /* The fingers left the touchpad: drop the part of a notch still left
+     * over, so it does not carry into the next, unrelated scroll. */
+    pthread_mutex_lock(&axis_mutex);
+    axis_distance[axis] = 0;
+    pthread_mutex_unlock(&axis_mutex);
 }
 
