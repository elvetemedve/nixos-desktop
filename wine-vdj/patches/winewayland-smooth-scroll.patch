+
+    pthread_mutex_lock(&axis_mutex);
+    axis_notch_in_frame[WL_POINTER_AXIS_VERTICAL_SCROLL] = FALSE;
+    axis_notch_in_frame[WL_POINTER_AXIS_HORIZONTAL_SCROLL] = FALSE;
+    pthread_mutex_unlock(&axis_mutex);
