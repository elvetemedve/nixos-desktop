 /***********************************************************************
+ *           get_toplevel_at
+ *
+ * The visible toplevel, other than the given window, that holds a point,
+ * preferably the foreground one.
+ */
+static HWND get_toplevel_at(HWND hwnd, int x, int y)
+{
+    HWND foreground = NtUserGetAncestor(NtUserGetForegroundWindow(), GA_ROOT), ret = 0;
+    struct wayland_win_data *data;
+    POINT pt = {x, y};
+
+    pthread_mutex_lock(&win_data_mutex);
+    RB_FOR_EACH_ENTRY(data, &win_data_rb, struct wayland_win_data, entry)
+    {
+        struct wayland_surface *surface = data->wayland_surface;
+
+        if (data->hwnd == hwnd || !surface || !wayland_surface_is_toplevel(surface)) continue;
+        if (!surface->window.visible || !PtInRect(&data->rects.window, pt)) continue;
+        if (!ret || data->hwnd == foreground) ret = data->hwnd;
+    }
+    pthread_mutex_unlock(&win_data_mutex);
+
+    return ret;
+}
+
+/* Whether a toplevel of ours holds a point: 1 if so, 0 if not, -1 if the
+ * window is not a toplevel. */
+static int toplevel_holds_point(HWND hwnd, int x, int y)
+{
+    struct wayland_win_data *data;
+    POINT pt = {x, y};
+    int ret = -1;
+
+    if (!(data = wayland_win_data_get(hwnd))) return -1;
+    if (data->wayland_surface && wayland_surface_is_toplevel(data->wayland_surface))
+        ret = PtInRect(&data->rects.window, pt);
+    wayland_win_data_release(data);
+    return ret;
+}
+
+/* The window whose surface the given window's surface hangs from in the
+ * end, itself if it is no subsurface. */
+static HWND get_root_surface_window(HWND hwnd)
+{
+    unsigned int limit = 8;
+    HWND owner;
+
+    while (hwnd && limit-- && (owner = get_subsurface_owner(hwnd))) hwnd = owner;
+    return hwnd;
+}
+
+/* The toplevel the pointer is in. */
+static HWND get_pointer_toplevel(void)
+{
+    struct wayland_pointer *pointer = &process_wayland.pointer;
+    HWND hwnd;
+
+    pthread_mutex_lock(&pointer->mutex);
+    hwnd = pointer->focused_hwnd;
+    pthread_mutex_unlock(&pointer->mutex);
+
+    return get_root_surface_window(hwnd);
+}
+
