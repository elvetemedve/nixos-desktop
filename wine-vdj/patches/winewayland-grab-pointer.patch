diff -urN a/dlls/winewayland.drv/wayland_pointer.c b/dlls/winewayland.drv/wayland_pointer.c
--- a/dlls/winewayland.drv/wayland_pointer.c	2026-11-13 23:34:34.096036583 +0100
+++ b/dlls/winewayland.drv/wayland_pointer.c	2026-11-13 23:34:34.099592981 +0100
@@ -128,8 +128,14 @@
     RECT rect, *window_rect = &rect;
     HWND hwnd;
     POINT screen = { wl_fixed_to_double(sx), wl_fixed_to_double(sy) };
+    struct wayland_pointer *pointer = &process_wayland.pointer;
     struct wayland_surface *surface;
     struct wayland_win_data *data;
+    BOOL grabbed;
+
+    pthread_mutex_lock(&pointer->mutex);
+    grabbed = pointer->button_serial != 0;
+    pthread_mutex_unlock(&pointer->mutex);
 
     if (!(hwnd = wayland_pointer_get_focused_hwnd())) return;
     if (!(data = wayland_win_data_get(hwnd))) return;
@@ -149,11 +155,17 @@
     screen.x += window_rect->left;
     screen.y += window_rect->top;
     /* Sometimes, due to rounding, we may end up with pointer coordinates
-     * slightly outside the target window, so bring them within bounds. */
-    if (screen.x >= window_rect->right) screen.x = window_rect->right - 1;
-    else if (screen.x < window_rect->left) screen.x = window_rect->left;
-    if (screen.y >= window_rect->bottom) screen.y = window_rect->bottom - 1;
-    else if (screen.y < window_rect->top) screen.y = window_rect->top;
+     * slightly outside the target window, so bring them within bounds.
+     * Not while a button is held: the compositor then keeps sending the
+     * pointer to this surface wherever it goes, and a drag that leaves the
+     * window (resizing it by an edge) has to see the real position. */
+    if (!grabbed)
+    {
+        if (screen.x >= window_rect->right) screen.x = window_rect->right - 1;
+        else if (screen.x < window_rect->left) screen.x = window_rect->left;
+        if (screen.y >= window_rect->bottom) screen.y = window_rect->bottom - 1;
+        else if (screen.y < window_rect->top) screen.y = window_rect->top;
+    }
 
     wayland_win_data_release(data);
 
