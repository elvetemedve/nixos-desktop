     SetRect(&monitor.rc_monitor, output_info->x, output_info->y,
             output_info->x + output_info->output->current_mode->width,
@@ -294,9 +355,12 @@
         monitor.rc_work.bottom = monitor.rc_work.top + (work_height * height + logical_h / 2) / logical_h;
     }
 
-    TRACE("name=%s rc_monitor=%s rc_work=%s\n",
