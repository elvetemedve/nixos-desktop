+/* Pinch scale ratio between two wheel notches. */
+#define PINCH_NOTCH_RATIO 1.15
+
+static void pinch_handle_begin(void *data, struct zwp_pointer_gesture_pinch_v1 *pinch,
+                               uint32_t serial, uint32_t time,
+                               struct wl_surface *wl_surface, uint32_t fingers)
+{
+    struct wayland_pointer *pointer = &process_wayland.pointer;
+
+    TRACE("fingers=%u\n", fingers);
+
+    pthread_mutex_lock(&pointer->mutex);
+    pointer->pinch_notches = 0;
+    pthread_mutex_unlock(&pointer->mutex);
+}
+
+/* Touchpad pinch, turned into vertical wheel notches at the pointer:
+ * spreading the fingers is wheel up, pinching them together wheel down.
+ * Windows itself would add MK_CONTROL (pinch as Ctrl+wheel), but plain
+ * wheel is what zooms in apps that zoom on the wheel. */
+static void pinch_handle_update(void *data, struct zwp_pointer_gesture_pinch_v1 *pinch,
+                                uint32_t time, wl_fixed_t dx, wl_fixed_t dy,
+                                wl_fixed_t scale, wl_fixed_t rotation)
+{
+    struct wayland_pointer *pointer = &process_wayland.pointer;
+    INPUT input = {.type = INPUT_MOUSE, .mi.dwFlags = MOUSEEVENTF_WHEEL};
+    double ratio = wl_fixed_to_double(scale);
+    int notches, sent;
+    HWND hwnd;
+
+    /* The scale is relative to the start of the gesture. */
+    if (ratio <= 0) return;
+    if (!(hwnd = wayland_pointer_get_focused_hwnd())) return;
+
+    notches = trunc(log(ratio) / log(PINCH_NOTCH_RATIO));
+
+    pthread_mutex_lock(&pointer->mutex);
+    sent = pointer->pinch_notches;
+    pointer->pinch_notches = notches;
+    pthread_mutex_unlock(&pointer->mutex);
+
+    TRACE("hwnd=%p scale=%f notches=%d sent=%d\n", hwnd, ratio, notches, sent);
+
+    /* One message per notch: some apps step once per WM_MOUSEWHEEL
+     * whatever its delta. */
+    for (; sent < notches; sent++)
+    {
+        input.mi.mouseData = WHEEL_DELTA;
+        NtUserSendHardwareInput(hwnd, SEND_HWMSG_RAWINPUT, &input, 0);
+    }
+    for (; sent > notches; sent--)
+    {
+        input.mi.mouseData = -WHEEL_DELTA;
+        NtUserSendHardwareInput(hwnd, SEND_HWMSG_RAWINPUT, &input, 0);
+    }
+}
+
+static void pinch_handle_end(void *data, struct zwp_pointer_gesture_pinch_v1 *pinch,
+                             uint32_t serial, uint32_t time, int32_t cancelled)
+{
+}
+
+static const struct zwp_pointer_gesture_pinch_v1_listener pinch_listener =
+{
+    pinch_handle_begin,
+    pinch_handle_update,
+    pinch_handle_end
+};
+
+void wayland_pointer_init_gestures(void)
+{
+    struct wayland_pointer *pointer = &process_wayland.pointer;
+
+    if (!process_wayland.zwp_pointer_gestures_v1) return;
+    if (!pointer->wl_pointer || pointer->zwp_pointer_gesture_pinch_v1) return;
+
+    pointer->zwp_pointer_gesture_pinch_v1 =
+        zwp_pointer_gestures_v1_get_pinch_gesture(process_wayland.zwp_pointer_gestures_v1,
+                                                  pointer->wl_pointer);
+    zwp_pointer_gesture_pinch_v1_add_listener(pointer->zwp_pointer_gesture_pinch_v1,
+                                              &pinch_listener, NULL);
+}
+
