+#ifdef XI_GesturePinchBegin
+
+/* pinch scale ratio between two wheel notches */
+#define PINCH_NOTCH_RATIO 1.15
+
+/***********************************************************************
+ *           X11DRV_GesturePinchEvent
+ *
+ * Touchpad pinch, turned into vertical wheel notches at the cursor:
+ * spreading the fingers is wheel up, pinching them together wheel down.
+ * Windows itself would add MK_CONTROL (pinch as Ctrl+wheel), but plain
+ * wheel is what zooms in apps that zoom on the wheel, such as VirtualDJ's
+ * waveforms and BPM editor.
+ */
+static BOOL X11DRV_GesturePinchEvent( XGenericEventCookie *xev )
+{
+    XIGesturePinchEvent *event = xev->data;
+    struct x11drv_thread_data *thread_data = x11drv_thread_data();
+    UINT time = EVENT_x11_time_to_win32_time( event->time );
+    POINT pt = { 0, 0 };
+    int notches;
+
+    if (event->evtype == XI_GesturePinchBegin) thread_data->pinch_notches = 0;
+    if (event->evtype == XI_GesturePinchEnd) return TRUE;
+
+    /* event->scale is relative to the start of the gesture */
+    if (event->scale <= 0) return FALSE;
+    notches = trunc( log( event->scale ) / log( PINCH_NOTCH_RATIO ) );
+    TRACE( "pinch scale %f, notches %d (sent %d)\n", event->scale, notches, thread_data->pinch_notches );
+
+    /* one message per notch: some apps step once per WM_MOUSEWHEEL whatever its delta */
+    for (; thread_data->pinch_notches < notches; thread_data->pinch_notches++)
+        send_mouse_input( NULL, pt, MOUSEEVENTF_WHEEL, WHEEL_DELTA, time, NULL );
+    for (; thread_data->pinch_notches > notches; thread_data->pinch_notches--)
+        send_mouse_input( NULL, pt, MOUSEEVENTF_WHEEL, -WHEEL_DELTA, time, NULL );
+    return TRUE;
+}
+
+#endif /* XI_GesturePinchBegin */
+
 #endif /* HAVE_X11_EXTENSIONS_XINPUT2_H */
 
 
