             hr = wined3d_texture_create(device->wined3d_device, &wined3d_desc,
                     desc->ArraySize, levels, flags, (struct wined3d_sub_resource_data *)data,
                     texture, &d3d_texture2d_wined3d_parent_ops, &texture->wined3d_texture);
+            if (hr == WINED3DERR_INVALIDCALL && desc->Format == DXGI_FORMAT_NV12
+                    && levels == 1 && desc->ArraySize == 1 && desc->SampleDesc.Count <= 1
+                    && desc->BindFlags == D3D11_BIND_SHADER_RESOURCE)
+                hr = d3d_texture2d_create_nv12(device, &wined3d_desc, data, texture);
         }
