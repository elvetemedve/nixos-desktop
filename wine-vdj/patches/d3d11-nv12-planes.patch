+/* wined3d's OpenGL renderer has no planar formats, and so no NV12 texture.
+ * One that is only read by shaders can be had as two textures, since the
+ * views a shader reads it through are of one plane each: R8 for luma, R8G8
+ * for chroma. Nothing else is done for it: mapping, updating or copying
+ * such a texture reaches its luma plane only. */
+static HRESULT d3d_texture2d_create_nv12(struct d3d_device *device, const struct wined3d_resource_desc *desc,
+        const D3D11_SUBRESOURCE_DATA *data, struct d3d_texture2d *texture)
+{
+    struct wined3d_sub_resource_data plane_data = {0};
+    struct wined3d_resource_desc plane_desc = *desc;
+    unsigned int pitch = 0;
+    HRESULT hr;
+
+    if ((desc->width & 1) || (desc->height & 1))
+        return WINED3DERR_INVALIDCALL;
+
+    if (data)
+    {
+        pitch = data->SysMemPitch ? data->SysMemPitch : desc->width;
+        plane_data.row_pitch = pitch;
+    }
+
+    /* The luma plane is made last: it owns the d3d11 texture, which would go
+     * with it were it the one to be let go of. */
+    plane_desc.format = WINED3DFMT_R8G8_UNORM;
+    plane_desc.width = desc->width / 2;
+    plane_desc.height = desc->height / 2;
+    plane_data.data = data ? (const BYTE *)data->pSysMem + pitch * desc->height : NULL;
+    if (FAILED(hr = wined3d_texture_create(device->wined3d_device, &plane_desc, 1, 1, 0,
+            data ? &plane_data : NULL, NULL, &d3d_null_wined3d_parent_ops, &texture->nv12_chroma)))
+        return hr;
+
+    plane_desc.format = WINED3DFMT_R8_UNORM;
+    plane_desc.width = desc->width;
+    plane_desc.height = desc->height;
+    plane_data.data = data ? data->pSysMem : NULL;
+    if (FAILED(hr = wined3d_texture_create(device->wined3d_device, &plane_desc, 1, 1, 0,
+            data ? &plane_data : NULL, texture, &d3d_texture2d_wined3d_parent_ops, &texture->wined3d_texture)))
+    {
+        wined3d_texture_decref(texture->nv12_chroma);
+        texture->nv12_chroma = NULL;
+        return hr;
+    }
+
+    WARN("Made %ux%u NV12 texture %p of two, usage %#x, bind flags %#x, access %#x, data %p.\n",
+            desc->width, desc->height, texture, desc->usage, desc->bind_flags, desc->access, data);
+    return hr;
+}
