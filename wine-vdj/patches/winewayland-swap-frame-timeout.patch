+/**********************************************************************
+ *           wayland_drawable_wait_frame
+ *
+ * Waits until the compositor wants the frame after the last one we gave
+ * it, but no longer than FRAME_TIMEOUT_MS.
+ *
+ * EGL would do the waiting itself, with a swap interval, but it waits for
+ * as long as it takes, and a compositor asks for no frames at all while a
+ * surface is hidden, minimized or covered. A thread that swaps would then
+ * hang, with whatever locks it holds.
+ */
+static void wayland_drawable_wait_frame(struct wayland_gl_drawable *gl)
+{
+    struct timespec timeout = {.tv_nsec = FRAME_TIMEOUT_MS * 1000000};
+
+    /* An application may go on drawing to a window it has hidden, for as
+     * long as it likes, and the thread that draws for it may hold locks
+     * that its other threads need: with wined3d, one thread draws every
+     * window of the process. So once the compositor has stopped asking,
+     * do not wait at all until it asks again, which is also what happens
+     * to a hidden window with the X11 driver. */
+    if (gl->stalled) timeout.tv_nsec = 0;
+
+    while (gl->frame_callback)
+    {
+        if (wl_display_dispatch_queue_timeout(process_wayland.wl_display, gl->frame_queue, &timeout) <= 0)
+            break;
+    }
+
+    if (!gl->frame_callback)
+    {
+        if (gl->stalled) TRACE("drawable %s, frame callbacks are back\n", debugstr_opengl_drawable(&gl->base));
+        gl->stalled = FALSE;
+        return;
+    }
+
+    if (!gl->stalled)
+    {
+        TRACE("drawable %s, no frame callback in %u ms\n", debugstr_opengl_drawable(&gl->base), FRAME_TIMEOUT_MS);
+        gl->stalled = TRUE;
+        gl->stalled_swaps = 0;
+    }
+
+    /* The callback stays, to tell us when the surface is shown again. Ask
+     * anew now and then, in case the compositor has dropped it. */
+    if (++gl->stalled_swaps % STALLED_RENEW_SWAPS == 0)
+    {
+        wl_callback_destroy(gl->frame_callback);
+        gl->frame_callback = NULL;
+    }
 }
 
