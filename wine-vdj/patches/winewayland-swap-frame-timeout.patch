+/* How long a swap waits for the compositor to ask for the next frame. */
+#define FRAME_TIMEOUT_MS 100
+/* How many swaps go by, once it has stopped asking, before the frame request
+ * is made anew. */
+#define STALLED_RENEW_SWAPS 64
