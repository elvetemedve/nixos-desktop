+/* Whether the rectangle is the work area of its monitor, where that is
+ * smaller than the monitor. Sizes go through the surface scale and back, so
+ * allow for rounding. */
+static BOOL is_work_area_rect(const RECT *rect)
+{
+    MONITORINFO info = {.cbSize = sizeof(info)};
+    HMONITOR monitor;
+
+    if (IsRectEmpty(rect)) return FALSE;
+    if (!(monitor = NtUserMonitorFromRect(rect, MONITOR_DEFAULTTONULL))) return FALSE;
+    if (!NtUserGetMonitorInfo(monitor, &info)) return FALSE;
+    if (EqualRect(&info.rcWork, &info.rcMonitor)) return FALSE;
+
+    return abs(rect->left - info.rcWork.left) <= 2 && abs(rect->top - info.rcWork.top) <= 2 &&
+           abs(rect->right - info.rcWork.right) <= 2 && abs(rect->bottom - info.rcWork.bottom) <= 2;
+}
