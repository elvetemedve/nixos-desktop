+static void xdg_toplevel_handle_configure_bounds(void *private, struct xdg_toplevel *xdg_toplevel,
+                                                 int32_t width, int32_t height)
+{
+    HWND hwnd = private;
+    BOOL changed;
+
+    TRACE("hwnd=%p %dx%d\n", hwnd, width, height);
+
+    if (width <= 0 || height <= 0) return;
+
+    pthread_mutex_lock(&process_wayland.output_mutex);
+    changed = process_wayland.work_width != width || process_wayland.work_height != height;
+    process_wayland.work_width = width;
+    process_wayland.work_height = height;
+    pthread_mutex_unlock(&process_wayland.output_mutex);
+
+    /* This is the only word we get about the work area, so report it as
+     * such. Only this process knows it, so it also has to do the update. */
+    if (changed) NtUserPostMessage(hwnd, WM_WAYLAND_INIT_DISPLAY_DEVICES, 0, 0);
+}
+
 static const struct xdg_toplevel_listener xdg_toplevel_listener =
 {
     xdg_toplevel_handle_configure,
-    xdg_toplevel_handle_close
+    xdg_toplevel_handle_close,
+    xdg_toplevel_handle_configure_bounds
 };
 
