 /***********************************************************************
+ *           is_placed_popup
+ *
+ * Whether a window is a bare popup, with no frame or title bar controls
+ * of its own: a menu, a dropdown, a panel the application puts at a
+ * position of its choosing.
+ */
+static BOOL is_placed_popup(HWND hwnd)
+{
+    DWORD style = NtUserGetWindowLongW(hwnd, GWL_STYLE);
+
+    if (!(style & WS_POPUP) || (style & WS_CHILD)) return FALSE;
+    if ((style & WS_CAPTION) == WS_CAPTION) return FALSE;
+    if (style & (WS_THICKFRAME | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX)) return FALSE;
+    if (NtUserGetWindowLongW(hwnd, GWL_EXSTYLE) & WS_EX_APPWINDOW) return FALSE;
+    return TRUE;
+}
+
+/***********************************************************************
+ *           get_subsurface_owner
+ *
+ * The window that a window's surface is currently a subsurface of, if any.
+ */
+static HWND get_subsurface_owner(HWND hwnd)
+{
+    struct wayland_win_data *data;
+    struct wayland_surface *surface;
+    HWND owner = 0;
+
+    if (!(data = wayland_win_data_get(hwnd))) return 0;
+    if ((surface = data->wayland_surface) && surface->role == WAYLAND_SURFACE_ROLE_SUBSURFACE)
+        owner = surface->owner_hwnd;
+    wayland_win_data_release(data);
+    return owner;
+}
+
+/***********************************************************************
+ *           get_placed_popup_owner
+ *
+ * The window to place a popup relative to, if there is one.
+ *
+ * A Wayland toplevel cannot be positioned, so a popup that became one
+ * would show up wherever the compositor puts new windows, rather than
+ * where the application wants it. As a subsurface of one of our toplevels
+ * it can be placed exactly.
+ */
+static HWND get_placed_popup_owner(HWND hwnd, HWND owner_hint)
+{
+    HWND owner;
+
+    if (!is_placed_popup(hwnd)) return 0;
+
+    /* The owner, or failing that the window the popup is on top of. */
+    if ((owner = owner_hint) && owner != hwnd && wayland_win_data_exists(owner)) return owner;
+    /* The window we attached it to before. */
+    if ((owner = get_subsurface_owner(hwnd)) && wayland_win_data_exists(owner)) return owner;
+    /* The window the user is working in. */
+    if ((owner = NtUserGetForegroundWindow()) && (owner = NtUserGetAncestor(owner, GA_ROOT)) &&
+        owner != hwnd && wayland_win_data_exists(owner)) return owner;
+
+    return 0;
+}
+
