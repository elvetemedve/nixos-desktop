+/* A shared texture is copied to the devices that opened it when the
+ * application has finished drawing to it, which it shows by taking it off
+ * as render target. */
+static void d3d11_device_context_set_shared_target(struct d3d11_device_context *context,
+        ID3D11RenderTargetView *view)
+{
+    struct d3d_rendertarget_view *rtv = unsafe_impl_from_ID3D11RenderTargetView(view);
+    struct d3d_texture2d *previous = context->shared_target;
+
+    if (context->type != D3D11_DEVICE_CONTEXT_IMMEDIATE)
+        return;
+
+    context->shared_target = rtv ? rtv->shared_texture : NULL;
+    if (previous && previous != context->shared_target)
+        d3d_texture2d_push_shared(previous);
+}
