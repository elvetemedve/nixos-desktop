+/* Wine has no shared resources. Two devices of one process are served by
+ * giving the opening device a texture of its own and copying into it. */
+HRESULT d3d_texture2d_open_shared(struct d3d_device *device, HANDLE handle, struct d3d_texture2d **out)
+{
+    static const D3D11_QUERY_DESC query_desc = {D3D11_QUERY_EVENT, 0};
+    struct d3d_texture2d *source = NULL, *staging = NULL, *texture, *cursor;
+    struct d3d_query *query = NULL;
+    D3D11_TEXTURE2D_DESC desc;
+    HRESULT hr;
+
+    wined3d_mutex_lock();
+    LIST_FOR_EACH_ENTRY(cursor, &shared_textures, struct d3d_texture2d, shared_entry)
+    {
+        if (wined3d_texture_get_resource(cursor->wined3d_texture) == handle && cursor->refcount)
+        {
+            source = cursor;
+            ID3D11Texture2D_AddRef(&source->ID3D11Texture2D_iface);
+            break;
+        }
+    }
+    wined3d_mutex_unlock();
+
+    if (!source)
+        return E_INVALIDARG;
+
+    if (source->device == &device->ID3D11Device5_iface)
+    {
+        *out = source;
+        return S_OK;
+    }
+
+    desc = source->desc;
+    if (desc.MipLevels != 1 || desc.ArraySize != 1 || desc.SampleDesc.Count > 1)
+    {
+        FIXME("Unhandled shared texture, %u levels, %u layers, %u samples.\n",
+                desc.MipLevels, desc.ArraySize, desc.SampleDesc.Count);
+        ID3D11Texture2D_Release(&source->ID3D11Texture2D_iface);
+        return E_NOTIMPL;
+    }
+
+    if (!source->shared_staging)
+    {
+        desc.Usage = D3D11_USAGE_STAGING;
+        desc.BindFlags = 0;
+        desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        desc.MiscFlags = 0;
+        if (FAILED(hr = d3d_texture2d_create(impl_from_ID3D11Device5(source->device),
+                &desc, NULL, NULL, &staging)))
+        {
+            ID3D11Texture2D_Release(&source->ID3D11Texture2D_iface);
+            return hr;
+        }
+        if (FAILED(hr = d3d_query_create(impl_from_ID3D11Device5(source->device),
+                &query_desc, FALSE, &query)))
+        {
+            ID3D11Texture2D_Release(&staging->ID3D11Texture2D_iface);
+            ID3D11Texture2D_Release(&source->ID3D11Texture2D_iface);
+            return hr;
+        }
+    }
+
+    desc = source->desc;
+    desc.MiscFlags &= ~D3D11_RESOURCE_MISC_SHARED;
+    if (FAILED(hr = d3d_texture2d_create(device, &desc, NULL, NULL, &texture)))
+    {
+        if (query)
+            ID3D11Query_Release(&query->ID3D11Query_iface);
+        if (staging)
+            ID3D11Texture2D_Release(&staging->ID3D11Texture2D_iface);
+        ID3D11Texture2D_Release(&source->ID3D11Texture2D_iface);
+        return hr;
+    }
+
+    wined3d_mutex_lock();
+    texture->desc.MiscFlags = source->desc.MiscFlags;
+    texture->shared_source = source;
+    list_add_tail(&source->shared_copies, &texture->shared_copy_entry);
+    if (staging && !source->shared_staging)
+    {
+        source->shared_staging = staging;
+        source->shared_query = query;
+        staging = NULL;
+        query = NULL;
+    }
+    wined3d_mutex_unlock();
+    if (query)
+        ID3D11Query_Release(&query->ID3D11Query_iface);
+    if (staging)
+        ID3D11Texture2D_Release(&staging->ID3D11Texture2D_iface);
+
+    TRACE("Opened %ux%u texture %p as copy %p.\n", desc.Width, desc.Height, source, texture);
+    *out = texture;
+    return S_OK;
+}
+
+/* Brings the copies of a shared texture up to date. Reading a texture back
+ * waits for the thread that draws for its device, with the wined3d lock
+ * held, so this is done by the thread that drew to the texture and not by
+ * the ones that use the copies. It also hands on what an earlier call
+ * asked for and only then asks for the present content, and it does
+ * neither until the drawing thread has got as far as the earlier request:
+ * the copies are a frame or more late and the wait is short. */
+void d3d_texture2d_push_shared(struct d3d_texture2d *source)
+{
+    struct wined3d_resource *src, *staging;
+    struct wined3d_device_context *context;
+    struct d3d_texture2d *cursor, *copy;
+    struct wined3d_map_desc map;
+    LARGE_INTEGER start, end, freq;
+    struct wined3d_box box;
+    BOOL found = FALSE;
+
+    wined3d_mutex_lock();
+    /* The caller's pointer may be stale. */
+    LIST_FOR_EACH_ENTRY(cursor, &shared_textures, struct d3d_texture2d, shared_entry)
+    {
+        if (cursor == source)
+            found = TRUE;
+    }
+    if (!found || !source->shared_staging || list_empty(&source->shared_copies))
+    {
+        wined3d_mutex_unlock();
+        return;
+    }
+
+    if (source->shared_staging_valid
+            && wined3d_query_get_data(source->shared_query->wined3d_query, NULL, 0, 0) != S_OK)
+    {
+        wined3d_mutex_unlock();
+        return;
+    }
+
+    QueryPerformanceCounter(&start);
+    context = impl_from_ID3D11Device5(source->device)->immediate_context.wined3d_context;
+    src = wined3d_texture_get_resource(source->wined3d_texture);
+    staging = wined3d_texture_get_resource(source->shared_staging->wined3d_texture);
+
+    if (source->shared_staging_valid
+            && SUCCEEDED(wined3d_resource_map(staging, 0, &map, NULL, WINED3D_MAP_READ)))
+    {
+        wined3d_box_set(&box, 0, 0, source->desc.Width, source->desc.Height, 0, 1);
+        LIST_FOR_EACH_ENTRY(copy, &source->shared_copies, struct d3d_texture2d, shared_copy_entry)
+        {
+            wined3d_device_context_update_sub_resource(
+                    impl_from_ID3D11Device5(copy->device)->immediate_context.wined3d_context,
+                    wined3d_texture_get_resource(copy->wined3d_texture),
+                    0, &box, map.data, map.row_pitch, map.slice_pitch, 0);
+        }
+        wined3d_resource_unmap(staging, 0);
+    }
+
+    wined3d_device_context_copy_resource(context, staging, src);
+    wined3d_device_context_issue_query(context, source->shared_query->wined3d_query, WINED3DISSUE_END);
+    wined3d_device_context_flush(context);
+    source->shared_staging_valid = TRUE;
+    QueryPerformanceCounter(&end);
+    wined3d_mutex_unlock();
+
+    QueryPerformanceFrequency(&freq);
+    if ((end.QuadPart - start.QuadPart) * 1000 / freq.QuadPart >= 4)
+        WARN("Copying shared texture %p took %I64d ms.\n", source,
+                (end.QuadPart - start.QuadPart) * 1000 / freq.QuadPart);
+}
+
