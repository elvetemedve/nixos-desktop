 /***********************************************************************
+ *           wayland_window_follow_output
+ *
+ * Moves a toplevel, in Win32 terms, to the monitor of the output its
+ * surface is on. The compositor places toplevels and the user moves them
+ * between outputs, and an application that asks which monitor its window
+ * is on, to maximize it or make it full screen there, has to get that one.
+ */
+static void wayland_window_follow_output(HWND hwnd)
+{
+    struct wayland_win_data *data;
+    struct wayland_surface *surface;
+    struct wl_output *wl_output = NULL;
+    RECT rect, monitor, old_monitor;
+    POINT offset = {0};
+
+    if (!(data = wayland_win_data_get(hwnd))) return;
+    if ((surface = data->wayland_surface) && wayland_surface_is_toplevel(surface) && !data->app_move)
+        wl_output = surface->outputs[0];
+    rect = data->rects.window;
+    wayland_win_data_release(data);
+
+    if (!wayland_output_get_monitor_rect(wl_output, &monitor)) return;
+    if (rect.left <= -32000 || IsRectEmpty(&rect)) return;
+    if (wayland_output_from_rect(&rect, &old_monitor))
+    {
+        if (EqualRect(&monitor, &old_monitor)) return;
+        offset.x = max(0, rect.left - old_monitor.left);
+        offset.y = max(0, rect.top - old_monitor.top);
+        if (offset.x >= monitor.right - monitor.left) offset.x = 0;
+        if (offset.y >= monitor.bottom - monitor.top) offset.y = 0;
+    }
+    OffsetRect(&rect, monitor.left + offset.x - rect.left, monitor.top + offset.y - rect.top);
+
+    TRACE("hwnd=%p monitor=%s rect=%s\n", hwnd, wine_dbgstr_rect(&monitor), wine_dbgstr_rect(&rect));
+
+    if (!(data = wayland_win_data_get(hwnd))) return;
+    data->in_configure = TRUE;
+    wayland_win_data_release(data);
+
+    NtUserSetRawWindowPos(hwnd, rect, SWP_NOACTIVATE | SWP_NOZORDER | SWP_NOOWNERZORDER |
+                          SWP_NOSIZE | SWP_NOSENDCHANGING, FALSE);
+
+    if ((data = wayland_win_data_get(hwnd)))
+    {
+        data->in_configure = FALSE;
+        wayland_win_data_release(data);
+    }
+}
