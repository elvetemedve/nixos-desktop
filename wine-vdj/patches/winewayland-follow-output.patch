+/* Finds an output by its wl_output, or else by the monitor that holds the
+ * centre of a rectangle, and returns its monitor rectangle. */
+static struct wl_output *find_output(struct wl_output *wl_output, const RECT *rect, RECT *monitor_rect)
+{
+    struct output_info *primary = NULL, *output_info;
+    struct wl_array output_info_array;
+    struct wayland_output *output;
+    struct wl_output *ret = NULL;
+
+    wl_array_init(&output_info_array);
+
+    pthread_mutex_lock(&process_wayland.output_mutex);
+
+    wl_list_for_each(output, &process_wayland.output_list, link)
+    {
+        if (!output->current.current_mode) continue;
+        if (!(output_info = wl_array_add(&output_info_array, sizeof(*output_info)))) continue;
+        output_info->output = &output->current;
+        output_info->wl_output = output->wl_output;
+    }
+
+    output_info_array_arrange_physical_coords(&output_info_array);
+
+    wl_array_for_each(output_info, &output_info_array)
+    {
+        RECT r;
+
+        if (!primary) primary = output_info;
+        SetRect(&r, output_info->x, output_info->y,
+                output_info->x + output_info->output->current_mode->width,
+                output_info->y + output_info->output->current_mode->height);
+        OffsetRect(&r, -primary->x, -primary->y);
+
+        if (wl_output ? output_info->wl_output != wl_output :
+            ((rect->left + rect->right) / 2 < r.left || (rect->left + rect->right) / 2 >= r.right ||
+             (rect->top + rect->bottom) / 2 < r.top || (rect->top + rect->bottom) / 2 >= r.bottom))
+            continue;
+
+        ret = output_info->wl_output;
+        if (monitor_rect) *monitor_rect = r;
+        break;
+    }
+
+    pthread_mutex_unlock(&process_wayland.output_mutex);
+
+    wl_array_release(&output_info_array);
+    return ret;
+}
+
+BOOL wayland_output_get_monitor_rect(struct wl_output *wl_output, RECT *rect)
+{
+    return wl_output && find_output(wl_output, NULL, rect);
+}
+
+struct wl_output *wayland_output_from_rect(const RECT *rect, RECT *monitor_rect)
+{
+    return find_output(NULL, rect, monitor_rect);
+}
