+/* Keeps the list of outputs a surface is on. The first is where the window
+ * is taken to be; when that changes the window is told, as nothing else
+ * says on which monitor a toplevel is. */
+static void wayland_surface_update_outputs(HWND hwnd, struct wl_surface *wl_surface,
+                                           struct wl_output *wl_output, BOOL enter)
+{
+    struct wayland_win_data *data;
+    struct wayland_surface *surface;
+    struct wl_output *first;
+    int i, count = ARRAY_SIZE(surface->outputs);
+    BOOL changed = FALSE;
+
+    if (!(data = wayland_win_data_get(hwnd))) return;
+    if ((surface = data->wayland_surface) && surface->wl_surface == wl_surface)
+    {
+        first = surface->outputs[0];
+        for (i = 0; i < count; i++) if (surface->outputs[i] == wl_output) break;
+        if (i < count)
+        {
+            for (; i < count - 1; i++) surface->outputs[i] = surface->outputs[i + 1];
+            surface->outputs[count - 1] = NULL;
+        }
+        if (enter)
+        {
+            for (i = 0; i < count; i++) if (!surface->outputs[i]) break;
+            if (i < count) surface->outputs[i] = wl_output;
+        }
+        changed = surface->outputs[0] && surface->outputs[0] != first;
+    }
+    wayland_win_data_release(data);
+
+    if (changed) NtUserPostMessage(hwnd, WM_WAYLAND_OUTPUT_CHANGED, 0, 0);
+}
+
+static void wl_surface_handle_enter(void *private, struct wl_surface *wl_surface,
+                                    struct wl_output *wl_output)
+{
+    wayland_surface_update_outputs(private, wl_surface, wl_output, TRUE);
+}
+
+static void wl_surface_handle_leave(void *private, struct wl_surface *wl_surface,
+                                    struct wl_output *wl_output)
+{
+    wayland_surface_update_outputs(private, wl_surface, wl_output, FALSE);
+}
+
+static const struct wl_surface_listener wl_surface_listener =
+{
+    wl_surface_handle_enter,
+    wl_surface_handle_leave
+};
