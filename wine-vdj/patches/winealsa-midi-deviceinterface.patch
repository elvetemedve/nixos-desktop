+static unsigned int if_path_len(const WCHAR *path)
+{
+    unsigned int n = 0;
+
+    while (path[n]) n++;
+    return n;
+}
+
+static UINT midi_get_interface_size(const WCHAR *path, DWORD *size)
+{
+    if (!path[0]) return MMSYSERR_NOTSUPPORTED;
+    if (!size) return MMSYSERR_INVALPARAM;
+    *size = (if_path_len(path) + 1) * sizeof(WCHAR);
+    return MMSYSERR_NOERROR;
+}
+
+static UINT midi_get_interface(const WCHAR *path, WCHAR *out, DWORD size)
+{
+    unsigned int needed;
+
+    if (!path[0]) return MMSYSERR_NOTSUPPORTED;
+    needed = (if_path_len(path) + 1) * sizeof(WCHAR);
+    if (!out || size < needed) return MMSYSERR_INVALPARAM;
+    memcpy(out, path, needed);
+    return MMSYSERR_NOERROR;
+}
