+struct usb_info
+{
+    WCHAR path[MIDI_IF_PATH_LEN];
+    unsigned int vid, pid;
+    BOOL valid;
+};
+
+static BOOL read_sysfs_line(const char *path, char *buf, size_t size)
+{
+    ssize_t n;
+    int fd;
+
+    if ((fd = open(path, O_RDONLY)) == -1) return FALSE;
+    n = read(fd, buf, size - 1);
+    close(fd);
+    if (n <= 0) return FALSE;
+    buf[n] = '\0';
+    while (n > 0 && (buf[n - 1] == '\n' || buf[n - 1] == '\r')) buf[--n] = '\0';
+    return n > 0;
+}
+
+/* locate the USB interface carrying MIDI streaming (class 1, subclass 3) */
+static int find_midi_interface(const char *usb_dir)
+{
+    char path[PATH_MAX + 320], buf[16];
+    struct dirent *de;
+    int mi = -1;
+    DIR *dir;
+
+    if (!(dir = opendir(usb_dir))) return -1;
+    while ((de = readdir(dir)))
+    {
+        int cfg, intf;
+
+        if (sscanf(de->d_name, "%*[^:]:%d.%d", &cfg, &intf) != 2) continue;
+        snprintf(path, sizeof(path), "%s/%s/bInterfaceClass", usb_dir, de->d_name);
+        if (!read_sysfs_line(path, buf, sizeof(buf)) || strtol(buf, NULL, 16) != 1) continue;
+        snprintf(path, sizeof(path), "%s/%s/bInterfaceSubClass", usb_dir, de->d_name);
+        if (!read_sysfs_line(path, buf, sizeof(buf)) || strtol(buf, NULL, 16) != 3) continue;
+        mi = intf;
+        break;
+    }
+    closedir(dir);
+    return mi;
+}
+
+static void get_usb_info(snd_seq_client_info_t *cinfo, struct usb_info *info)
+{
+    char base[64], usb_dir[PATH_MAX], path[PATH_MAX + 64];
+    char vid[16], pid[16], serial[64], out[MIDI_IF_PATH_LEN];
+    int card, mi, len;
+    unsigned int i;
+
+    memset(info, 0, sizeof(*info));
+
+    if ((card = snd_seq_client_info_get_card(cinfo)) < 0) return;
+
+    /* cardN/device is the USB *interface*; the ids live on its parent device */
+    snprintf(base, sizeof(base), "/sys/class/sound/card%d/device/..", card);
+    if (!realpath(base, usb_dir)) return;
+
+    snprintf(path, sizeof(path), "%s/idVendor", usb_dir);
+    if (!read_sysfs_line(path, vid, sizeof(vid))) return;
+    snprintf(path, sizeof(path), "%s/idProduct", usb_dir);
+    if (!read_sysfs_line(path, pid, sizeof(pid))) return;
+    snprintf(path, sizeof(path), "%s/serial", usb_dir);
+    if (!read_sysfs_line(path, serial, sizeof(serial))) strcpy(serial, "0");
+
+    for (i = 0; serial[i]; i++)
+        if (serial[i] >= 'A' && serial[i] <= 'Z') serial[i] += 'a' - 'A';
+
+    if ((mi = find_midi_interface(usb_dir)) >= 0)
+        len = snprintf(out, sizeof(out), "\\\\?\\usb#vid_%s&pid_%s&mi_%02d#%s#"
+                       "{6994ad04-93ef-11d0-a3cc-00a0c9223196}", vid, pid, mi, serial);
+    else
+        len = snprintf(out, sizeof(out), "\\\\?\\usb#vid_%s&pid_%s#%s#"
+                       "{6994ad04-93ef-11d0-a3cc-00a0c9223196}", vid, pid, serial);
+    if (len <= 0 || len >= (int)sizeof(out)) return;
+
+    ntdll_umbstowcs(out, len + 1, info->path, ARRAY_SIZE(info->path));
+    info->vid = strtoul(vid, NULL, 16);
+    info->pid = strtoul(pid, NULL, 16);
+    info->valid = TRUE;
+    TRACE("card %d -> %s\n", card, wine_dbgstr_w(info->path));
+}
