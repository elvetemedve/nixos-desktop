 /***********************************************************************
+ *           get_subsurface_below
+ *
+ * The next window down in the z-order that is a subsurface of the given
+ * owner, if any.
+ *
+ * Subsurfaces of one owner are stacked among themselves, and Wayland
+ * leaves each where it was last put, so a window that is to be on top of
+ * its siblings, a menu opened from one of them for example, has to be put
+ * there.
+ */
+static HWND get_subsurface_below(HWND hwnd, HWND owner)
+{
+    unsigned int limit = 256;
+
+    while (limit-- && (hwnd = NtUserGetWindowRelative(hwnd, GW_HWNDNEXT)))
+        if (get_subsurface_owner(hwnd) == owner) return hwnd;
+    return 0;
+}
+
