 /**********************************************************************
+ *          wayland_surface_get_sibling_below
+ *
+ * The surface of the window that this subsurface goes right above, if
+ * that window is still a subsurface of the same owner.
+ */
+static struct wl_surface *wayland_surface_get_sibling_below(struct wayland_surface *surface)
+{
+    struct wayland_win_data *data;
+    struct wayland_surface *sibling;
+    struct wl_surface *wl_surface = NULL;
+
+    if (!surface->above_hwnd || surface->above_hwnd == surface->hwnd) return NULL;
+    if (!(data = wayland_win_data_get(surface->above_hwnd))) return NULL;
+
+    if ((sibling = data->wayland_surface) && sibling != surface &&
+        sibling->role == WAYLAND_SURFACE_ROLE_SUBSURFACE && sibling->wl_subsurface &&
+        sibling->owner_hwnd == surface->owner_hwnd)
+        wl_surface = sibling->wl_surface;
+
+    wayland_win_data_release(data);
+    return wl_surface;
+}
+
+/**********************************************************************
  *          wayland_surface_place_subsurface
  *
  * Sends the subsurface's position to the compositor.
@@ -937,10 +962,21 @@
         TRACE("hwnd=%p rect=%s\n", surface->hwnd, wine_dbgstr_rect(&rect));
 
         wl_subsurface_set_position(surface->wl_subsurface, rect.left, rect.top);
-        if (owner_data->client_surface && owner_data->client_surface->wl_subsurface)
-            wl_subsurface_place_above(surface->wl_subsurface, owner_data->client_surface->wl_surface);
-        else
-            wl_subsurface_place_above(surface->wl_subsurface, owner_surface->wl_surface);
+        if (surface->restack)
+        {
+            struct wl_surface *below = wayland_surface_get_sibling_below(surface);
+
+            /* Placing a subsurface above the owner puts it below every
+             * other subsurface of that owner, so this is only done when the
+             * order may have changed, not with every move. */
+            if (below)
+                wl_subsurface_place_above(surface->wl_subsurface, below);
+            else if (owner_data->client_surface && owner_data->client_surface->wl_subsurface)
+                wl_subsurface_place_above(surface->wl_subsurface, owner_data->client_surface->wl_surface);
+            else
+                wl_subsurface_place_above(surface->wl_subsurface, owner_surface->wl_surface);
+            surface->restack = FALSE;
+        }
         wl_surface_commit(owner_surface->wl_surface);
         wayland_surface_sync_subsurface_position(surface);
     }
diff -ru a/dlls/winewayland.drv/window.c b/dlls/winewayland.drv/window.c
