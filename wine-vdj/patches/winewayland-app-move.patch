 /***********************************************************************
+ *           is_app_move
+ *
+ * Whether a window rect change is a plain move: same size, new position.
+ * The minimize sentinel position is not a move.
+ */
+static BOOL is_app_move(const RECT *old_rect, const RECT *new_rect)
+{
+    if (new_rect->left <= -32000 || old_rect->left <= -32000) return FALSE;
+    if (new_rect->right - new_rect->left != old_rect->right - old_rect->left) return FALSE;
+    if (new_rect->bottom - new_rect->top != old_rect->bottom - old_rect->top) return FALSE;
+    return new_rect->left != old_rect->left || new_rect->top != old_rect->top;
+}
+
+/***********************************************************************
+ *           wayland_win_data_start_move
+ *
+ * Hands a move the application is doing by itself over to the compositor.
+ *
+ * An application that draws its own title bar moves its window with
+ * SetWindowPos on every mouse move. A Wayland client cannot place its
+ * toplevel, so the surface stays where it is while the Win32 position
+ * changes, and since pointer positions are reported relative to the
+ * surface, the pointer appears to have moved by the same amount. The
+ * application takes that for more dragging and moves again, further each
+ * time, until the window is off screen in Win32 terms and clicks no longer
+ * reach it.
+ */
+static BOOL wayland_win_data_start_move(struct wayland_win_data *data, uint32_t button_serial)
+{
+    struct wayland_surface *surface = data->wayland_surface;
+    struct wl_seat *wl_seat;
+    BOOL ret = FALSE;
+
+    if (!surface || !wayland_surface_is_toplevel(surface)) return FALSE;
+
+    pthread_mutex_lock(&process_wayland.seat.mutex);
+    if ((wl_seat = process_wayland.seat.wl_seat))
+    {
+        TRACE("hwnd=%p button_serial=%u\n", data->hwnd, button_serial);
+        xdg_toplevel_move(surface->xdg_toplevel, wl_seat, button_serial);
+        ret = TRUE;
+    }
+    pthread_mutex_unlock(&process_wayland.seat.mutex);
+
+    return ret;
+}
+
+/***********************************************************************
+ *           wayland_end_app_move
+ *
+ * Puts the window back where it was, in Win32 terms, before the
+ * application started moving it. The compositor has done the actual move,
+ * and the steps the application made before that took over would add up
+ * over many moves, pushing the window off screen in Win32 terms.
+ */
+static void wayland_end_app_move(HWND hwnd)
+{
+    struct wayland_win_data *data;
+    RECT rect;
+    BOOL moved;
+
+    if (!(data = wayland_win_data_get(hwnd))) return;
+    if (!data->app_move)
+    {
+        wayland_win_data_release(data);
+        return;
+    }
+    data->app_move = FALSE;
+    rect = data->rects.window;
+    moved = rect.left != data->app_move_origin.x || rect.top != data->app_move_origin.y;
+    OffsetRect(&rect, data->app_move_origin.x - rect.left, data->app_move_origin.y - rect.top);
+    wayland_win_data_release(data);
+
+    TRACE("hwnd=%p rect=%s moved=%d\n", hwnd, wine_dbgstr_rect(&rect), moved);
+
+    if (moved)
+        NtUserSetRawWindowPos(hwnd, rect, SWP_NOSIZE | SWP_NOACTIVATE | SWP_NOZORDER | SWP_NOOWNERZORDER, FALSE);
+}
