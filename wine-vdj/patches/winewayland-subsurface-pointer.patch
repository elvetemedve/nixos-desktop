+struct subsurface_sync
+{
+    HWND hwnd;
+    POINT origin;
+};
+
+static void subsurface_sync_handle_done(void *data, struct wl_callback *wl_callback, uint32_t serial)
+{
+    struct subsurface_sync *sync = data;
+    struct wayland_win_data *win_data;
+    struct wayland_surface *surface;
+
+    wl_callback_destroy(wl_callback);
+
+    if ((win_data = wayland_win_data_get(sync->hwnd)))
+    {
+        if ((surface = win_data->wayland_surface) && surface->role == WAYLAND_SURFACE_ROLE_SUBSURFACE)
+        {
+            surface->placed = TRUE;
+            surface->placed_origin = sync->origin;
+        }
+        wayland_win_data_release(win_data);
+    }
+
+    free(sync);
+}
+
+static const struct wl_callback_listener subsurface_sync_listener =
+{
+    subsurface_sync_handle_done
